NODE_ENV=development
PORT=4000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mahaswasthya

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mahaswasthya?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-me-with-a-secure-secret-in-production-access
