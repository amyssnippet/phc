NODE_ENV=production
PORT=4000

# -------------------------------------------------------------
# SERVER HOST / IP CONFIGURATION (IMPORTANT FOR REMOTE SERVERS)
# Replace YOUR_SERVER_IP with your actual public or LAN IP: e.g. 192.168.1.50 or 34.123.45.67
# -------------------------------------------------------------
# Backend API Base URL called by the browser client:
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# For Server deployment, uncomment and replace:
# NEXT_PUBLIC_API_BASE_URL=http://YOUR_SERVER_IP:4000/api/v1

# CORS Origin allowed by backend Express server:
CORS_ORIGIN=http://localhost:3000
# For Server deployment, uncomment and replace:
# CORS_ORIGIN=http://YOUR_SERVER_IP:3000

NEXT_PUBLIC_APP_NAME=SwasthyaSetu
NEXT_PUBLIC_DEMO_MODE=true

# Database & Cache (Used internally by Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mahaswasthya
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mahaswasthya?schema=public
REDIS_URL=redis://redis:6379

# Cryptographic Secrets
JWT_ACCESS_SECRET=replace-me-with-a-secure-secret-in-production-access-key-2026!
JWT_REFRESH_SECRET=replace-me-with-a-secure-secret-in-production-refresh-key-2026!

# Auth & Demo mode
OTP_MODE=MOCK
MOCK_OTP=123456
DEMO_MODE=true
LOG_LEVEL=info
